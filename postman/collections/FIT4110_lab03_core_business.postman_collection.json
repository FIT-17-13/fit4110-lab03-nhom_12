    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "Consumer smoke - Core calls AI Vision face-match",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestType\": \"IMAGE_REF\",\n  \"traceId\": \"0196fb3d-4ad7-7d1e-9f49-5d5148d2babc\",\n  \"imageRef\": \"https://storage.campus.local/frames/frame-001.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{aiVisionMockUrl}}/vision/face-match",
              "host": ["{{aiVisionMockUrl}}"],
              "path": ["vision", "face-match"]
            },
            "description": "Consumer-side smoke test: Core Business gọi API mock của AI Vision (service phụ thuộc)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consumer receives success from AI Vision mock', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Response matches FaceMatchResult schema', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('matchId');",
                  "  pm.expect(json).to.have.property('decision');",
                  "  pm.expect(json).to.have.property('confidence');",
                  "  pm.expect(json.confidence).to.be.within(0, 1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {

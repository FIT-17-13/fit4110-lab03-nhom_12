            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"RFID-2026-001\",\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"IN\",\n  \"timestamp\": \"2026-05-15T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
